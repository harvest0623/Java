<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.GoodsMapper">

    <!--
        实验核心：使用 resultMap + association 实现多表连接查询
        Goods 表的 user_id 关联 User 表的 id
    -->
    <resultMap id="GoodsWithUserMap" type="Goods">
        <!-- goods 表自身字段映射 -->
        <id     column="g_id"     property="id"/>
        <result column="g_title"  property="title"/>
        <result column="g_type"   property="type"/>
        <result column="g_price"  property="price"/>
        <result column="g_stock"  property="stock"/>
        <result column="g_user_id" property="userId"/>

        <!--
            association：关联单个对象（一对一）
            property  → Goods 实体中的 user 属性名
            javaType  → 关联类型全限定名（可以用 mybatis-config.xml 中的别名）
            内部再用 result 把 user 表列映射到 User 对象属性上
        -->
        <association property="user" javaType="User">
            <id     column="u_id"      property="id"/>
            <result column="u_name"    property="name"/>
            <result column="u_phone"   property="phone"/>
            <result column="u_address" property="address"/>
        </association>
    </resultMap>

    <!-- 查询所有商品（JOIN user 表，带 association 映射） -->
    <select id="findAllWithUser" resultMap="GoodsWithUserMap">
        SELECT
            g.id     AS g_id,
            g.title  AS g_title,
            g.type   AS g_type,
            g.price  AS g_price,
            g.stock  AS g_stock,
            g.user_id AS g_user_id,
            u.id     AS u_id,
            u.name   AS u_name,
            u.phone  AS u_phone,
            u.address AS u_address
        FROM goods g
                 LEFT JOIN user u ON g.user_id = u.id
    </select>

    <!-- 根据ID查询（关联用户） -->
    <select id="findByIdWithUser" resultMap="GoodsWithUserMap">
        SELECT
            g.id, g.title, g.type, g.price, g.stock, g.user_id,
            u.id AS u_id, u.name AS u_name, u.phone AS u_phone, u.address AS u_address
        FROM goods g
                 LEFT JOIN user u ON g.user_id = u.id
        WHERE g.id = #{id}
    </select>

    <!-- 动态 SQL 条件查询 -->
    <select id="findByCondition" resultMap="GoodsWithUserMap">
        SELECT
        g.id AS g_id, g.title AS g_title, g.type AS g_type,
        g.price AS g_price, g.stock AS g_stock, g.user_id AS g_user_id,
        u.id AS u_id, u.name AS u_name, u.phone AS u_phone, u.address AS u_address
        FROM goods g
        LEFT JOIN user u ON g.user_id = u.id
        <where>
            <if test="type != null and type != ''">
                AND g.type = #{type}
            </if>
            <if test="title != null and title != ''">
                AND g.title LIKE CONCAT('%', #{title}, '%')
            </if>
        </where>
    </select>

</mapper>